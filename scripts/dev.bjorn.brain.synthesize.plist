<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.bjorn.brain.synthesize</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>/opt/homebrew/bin/node /Users/bjornah/brain/code/server/dist/librarian/cli.js consolidate --synthesize &gt;&gt; /Users/bjornah/brain/.brain/log/launchd-synthesize.out 2&gt;&gt; /Users/bjornah/brain/.brain/log/launchd-synthesize.err</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>BRAIN_VAULT_ROOT</key>
        <string>/Users/bjornah/brain</string>
        <key>CLAUDE_BIN</key>
        <string>/Users/bjornah/.local/bin/claude</string>
        <key>PATH</key>
        <string>/Users/bjornah/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/bjornah/brain/.brain/log/launchd-synthesize.out</string>

    <key>StandardErrorPath</key>
    <string>/Users/bjornah/brain/.brain/log/launchd-synthesize.err</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
