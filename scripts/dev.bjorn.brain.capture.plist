<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.bjorn.brain.capture</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/bjornah/brain/code/capture/brain-capture.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>BRAIN_VAULT_ROOT</key>
        <string>/Users/bjornah/brain</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>12</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>17</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/bjornah/brain/.brain/log/launchd-capture.out</string>

    <key>StandardErrorPath</key>
    <string>/Users/bjornah/brain/.brain/log/launchd-capture.err</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
