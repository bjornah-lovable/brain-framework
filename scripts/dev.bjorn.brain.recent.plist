<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.bjorn.brain.recent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>/usr/bin/python3 /Users/bjornah/brain/scripts/build-recent.py &gt;&gt; /Users/bjornah/brain/.brain/log/launchd-recent.out 2&gt;&gt; /Users/bjornah/brain/.brain/log/launchd-recent.err</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/opt/homebrew/bin:/usr/local/bin</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>15</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/bjornah/brain/.brain/log/launchd-recent.out</string>

    <key>StandardErrorPath</key>
    <string>/Users/bjornah/brain/.brain/log/launchd-recent.err</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
